# Copy file ini menjadi ".env" di root project (sejajar dengan docker-compose.yml),
# lalu isi dengan nilai asli kamu. docker-compose otomatis membaca file ".env" ini.

# --- Database ---
# Backend Docker connect ke MySQL yang jalan di host (mis. Laragon/XAMPP),
# BUKAN ke database Docker terpisah - supaya cuma ada satu sumber data asli.
DB_NAME=finstart_db
DB_USER=root
DB_PASSWORD=
DB_PORT=3306
DB_POOL_SIZE=10

# --- Backend ---
BACKEND_PORT=4001
CORS_ORIGIN=http://localhost:5173
AUTH_SESSION_HOURS=8
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_MINUTES=1
DEMO_USER_EMAIL=finance@kedata.id
DEMO_USER_NAME=Finance Manager
DEMO_USER_PASSWORD=ganti-password-demo-ini

# AI Finstart lewat Ollama - jalankan Ollama di komputer/server host (di luar
# Docker) dan pastikan model di bawah sudah di-pull ("ollama pull qwen2.5:7b").
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b

# --- Frontend (di-bake saat build image, bukan runtime) ---
VITE_API_URL=http://localhost:4001/api
